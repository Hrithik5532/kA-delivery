# Copy to .env
VITE_API_URL=http://localhost:8001

# Google Maps — GCP project: Khana-any-where-user
# Enable: Maps JavaScript API, Places API (New), Maps Static API
# HTTP referrer restrictions: http://localhost:*  https://your-admin-domain/*
VITE_GOOGLE_MAPS_KEY=

VITE_MAP_CENTER=18.5204,73.8567
VITE_MAP_ZOOM=12

# Place search uses backend proxy — set GOOGLE_MAPS_API_KEY on the FastAPI server (.env).
