# ---- Digi Mess mobile public config (copy to .env) ----
# GCP project: Khana-any-where-user
# Enable for Android APK: Maps SDK for Android, Maps Embed API, Maps Static API
# Android key restriction: package com.digimess.rider + EAS build SHA-1 fingerprint

EXPO_PUBLIC_API_URL=http://localhost:8001
EXPO_PUBLIC_WS_URL=ws://localhost:8001

EXPO_PUBLIC_MAP_PROVIDER=google
EXPO_PUBLIC_MAP_API_KEY=

EXPO_PUBLIC_LOCATION_INTERVAL_MS=5000
EXPO_PUBLIC_LOCATION_DISTANCE_M=30
