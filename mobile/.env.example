# ---- Digi Mess mobile public config (copy to .env) ----
# Only EXPO_PUBLIC_* values are readable in the app. NEVER put backend secrets
# (JWT signing key, DB URL, payment secrets) here.
#
# On a physical device, localhost points at the phone, not your computer.
# Use your machine's LAN IP, e.g. http://192.168.0.122:8001 (run: ipconfig getifaddr en0).
# Cloudflare trycloudflare tunnels expire — use localhost or a fresh tunnel.
# Use 8001 if another service already occupies port 8000.

EXPO_PUBLIC_API_URL=http://localhost:8001
EXPO_PUBLIC_WS_URL=ws://localhost:8001

# Map provider: "none" uses the built-in dev fallback (no native map).
# Set to "google" (or "apple") AND provide a client key to enable real maps
# in a development/production build (not Expo Go).
# Also enable "Maps Embed API" + "Maps Static API" in GCP for web maps.
EXPO_PUBLIC_MAP_PROVIDER=none
EXPO_PUBLIC_MAP_API_KEY=

# Rider location cadence (client-side; the server also enforces its own policy)
EXPO_PUBLIC_LOCATION_INTERVAL_MS=5000
EXPO_PUBLIC_LOCATION_DISTANCE_M=30
